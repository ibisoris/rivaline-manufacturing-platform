  "measures": [
    {
      "name": "Orders",
      "expression": "MAX(Operations[order_count])",
      "format": "#,0",
      "description": "All-time noncancelled orders; unaffected by product/month filters."
    },
    {
      "name": "Sales Quantity kg",
      "expression": "CALCULATE(SUM(Orders[ordered_quantity]), Orders[order_status] <> \"cancelled\", Orders[unit_of_measure] = \"kg\")",
      "format": "#,0.00",
      "description": "Operational booked quantity, separate from the archived evaluation universe."
    },
    {
      "name": "Material On Hand kg",
      "expression": "CALCULATE(SUM(Inventory[on_hand_quantity]), Inventory[unit_of_measure] = \"kg\")",
      "format": "#,0.00",
      "description": "Pooled raw-material stock only; do not add finished goods."
    },
    {
      "name": "Projected Material kg",
      "expression": "CALCULATE(SUM(Inventory[projected_quantity]), Inventory[unit_of_measure] = \"kg\")",
      "format": "#,0.00",
      "description": "Phase 4 available plus assumed incoming less current requirements."
    },
    {
      "name": "Materials At Risk",
      "expression": "COUNTROWS(FILTER(Inventory, Inventory[risk_status] IN {\"shortage\", \"below_safety\", \"below_reorder\", \"invalid_policy\", \"incomplete_bom\"}))",
      "format": "#,0",
      "description": "Excludes at_reorder: equality does not trigger replenishment."
    },
    {
      "name": "Recommended Reorder kg",
      "expression": "CALCULATE(SUM(Reorders[quantity]), Material[unit_of_measure] = \"kg\", Reorders[status] = \"proposed\")",
      "format": "#,0.00",
      "description": "Selected immutable reorder run, proposed status; not open supply."
    },
    {
      "name": "Procurement Ordered kg",
      "expression": "CALCULATE(SUM(Procurement[ordered_quantity]), Procurement[unit_of_measure] = \"kg\", Procurement[order_status] <> \"cancelled\")",
      "format": "#,0.00",
      "description": "Ordered quantity, not measured receipts or on-time delivery."
    },
    {
      "name": "Archived Demand kg",
      "expression": "CALCULATE(SUM('Demand History'[quantity]), 'Demand History'[unit_of_measure] = \"kg\")",
      "format": "#,0.00",
      "description": "Alternative synthetic history; never add to operational sales."
    },
    {
      "name": "Forecast Demand kg",
      "expression": "CALCULATE(SUM(Forecast[quantity]), Forecast[unit_of_measure] = \"kg\")",
      "format": "#,0.000000",
      "description": "One selected forecast vintage, monthly future demand."
    },
    {
      "name": "Holdout Actual kg",
      "expression": "SUM(Backtest[actual_quantity])",
      "format": "#,0.000000",
      "description": "Actual demand on selected-model holdout months only."
    },
    {
      "name": "Holdout Prediction kg",
      "expression": "SUM(Backtest[predicted_quantity])",
      "format": "#,0.000000",
      "description": "Selected model prediction on holdout months only."
    },
    {
      "name": "Holdout Variance kg",
      "expression": "SUMX(Backtest, Backtest[predicted_quantity] - Backtest[actual_quantity])",
      "format": "#,0.000000",
      "description": "Signed holdout error; never future forecast minus missing future actual."
    },
    {
      "name": "Selected Policy MAE kg",
      "expression": "AVERAGEX(Backtest, ABS(Backtest[predicted_quantity] - Backtest[actual_quantity]))",
      "format": "#,0.000000",
      "description": "Mean absolute error across selected-model test observations, not mean candidate MAEs."
    },
    {
      "name": "Selected Policy RMSE kg",
      "expression": "SQRT(AVERAGEX(Backtest, POWER(Backtest[predicted_quantity] - Backtest[actual_quantity], 2)))",
      "format": "#,0.000000",
      "description": "Root of pooled squared selected-model test errors."
    },
    {
      "name": "Selected Model",
      "expression": "SELECTEDVALUE(Forecast[selected_model], \"Multiple selected models\")",
      "format": null,
      "description": "Shows a single selected model only when filter context supports one."
    },
    {
      "name": "Production Requirement kg",
      "expression": "CALCULATE(SUM('Production Plan'[net_requirement]), 'Production Plan'[unit_of_measure] = \"kg\")",
      "format": "#,0.000000",
      "description": "Forecast netted against original finished stock once across the horizon."
    },
    {
      "name": "Inventory Offset kg",
      "expression": "SUM('Production Plan'[inventory_offset])",
      "format": "#,0.000000",
      "description": "Stock offset within one selected plan; not new supply."
    },
    {
      "name": "Proposed Production kg",
      "expression": "SUM('Production Plan'[proposed_quantity])",
      "format": "#,0.000000",
      "description": "Includes any minimum-batch surplus; not approved execution."
    },
    {
      "name": "Allocated Production kg",
      "expression": "SUM('Production Plan'[allocated_quantity])",
      "format": "#,0.000000",
      "description": "Whole batches that fit both materials and residual capacity."
    },
    {
      "name": "Constrained Production kg",
      "expression": "CALCULATE(SUM('Production Plan'[unmet_quantity]), 'Production Plan'[status] <> \"FEASIBLE\")",
      "format": "#,0.000000",
      "description": "Unmet net demand, not the whole proposed quantity of a partly allocated line."
    },
    {
      "name": "Proposed Batches",
      "expression": "SUM('Production Plan'[batch_count])",
      "format": "#,0",
      "description": "Proposed computational batches; no execution records."
    },
    {
      "name": "Material Requirement kg",
      "expression": "CALCULATE(SUM('Planning Materials'[required_quantity]), 'Planning Materials'[unit_of_measure] = \"kg\")",
      "format": "#,0.00",
      "description": "Component needs at plan/product/month/material grain."
    },
    {
      "name": "Material Shortage kg",
      "expression": "CALCULATE(SUM('Planning Materials'[shortage_quantity]), 'Planning Materials'[unit_of_measure] = \"kg\")",
      "format": "#,0.00",
      "description": "Incremental shortages at the allocation turn, not a purchase instruction."
    },
    {
      "name": "Capacity Required Hours",
      "expression": "SUM(Capacity[required_hours])",
      "format": "#,0.00",
      "description": "Resource-month proposed workload; intentionally unaffected by product slicers."
    },
    {
      "name": "Capacity Available Hours",
      "expression": "SUM(Capacity[available_hours])",
      "format": "#,0.00",
      "description": "Shared residual capacity counted once per resource/month."
    },
    {
      "name": "Capacity Allocated Hours",
      "expression": "SUM(Capacity[allocated_hours])",
      "format": "#,0.00",
      "description": "Whole-batch allocated workload."
    },
    {
      "name": "Capacity Utilisation %",
      "expression": "DIVIDE([Capacity Required Hours], [Capacity Available Hours])",
      "format": "0.00%",
      "description": "Ratio of aggregate hours, not an average of row percentages; null if zero capacity."
    },
    {
      "name": "Capacity Shortfall Hours",
      "expression": "SUM(Capacity[overload_hours])",
      "format": "#,0.00",
      "description": "Sum positive resource-month overload; spare capacity elsewhere cannot cancel it."
    },
    {
      "name": "December Mixing Required Hours",
      "expression": "CALCULATE([Capacity Required Hours], REMOVEFILTERS('Calendar'), REMOVEFILTERS(Resource), 'Calendar'[Month] = \"2026-12\", Resource[code] = \"SYN-MIX\")",
      "format": "0.00",
      "description": "Explicit verified example; other cards show current page context."
    },
    {
      "name": "December Mixing Available Hours",
      "expression": "CALCULATE([Capacity Available Hours], REMOVEFILTERS('Calendar'), REMOVEFILTERS(Resource), 'Calendar'[Month] = \"2026-12\", Resource[code] = \"SYN-MIX\")",
      "format": "0.00",
      "description": "Explicit December resource capacity, not horizon sum."
    },
    {
      "name": "Batch QC Pass Rate %",
      "expression": "DIVIDE(MAX(Operations[passed_batch_count]), MAX(Operations[inspected_batch_count]))",
      "format": "0.00%",
      "description": "Phase 3 all-time eligible batch definition; not inspection pass rate."
    },
    {
      "name": "QC Inspections",
      "expression": "COUNTROWS(Quality)",
      "format": "#,0",
      "description": "Inspection-grain count, including repeats."
    },
    {
      "name": "QC Passed Inspections",
      "expression": "SUM(Quality[pass_indicator])",
      "format": "#,0",
      "description": "Passed inspection records; not released batches."
    },
    {
      "name": "ETL Accepted Rows",
      "expression": "MAX(Operations[etl_rows_accepted])",
      "format": "#,0",
      "description": "Successful execution events, including repeated accepted rows on replay."
    },
    {
      "name": "ETL Rejected Rows",
      "expression": "MAX(Operations[etl_rows_rejected])",
      "format": "#,0",
      "description": "Successful execution rejected events, including replay."
    },
    {
      "name": "ETL Acceptance Rate %",
      "expression": "DIVIDE([ETL Accepted Rows], MAX(Operations[etl_rows_extracted]))",
      "format": "0.00%",
      "description": "Weighted accepted/extracted across successful runs."
    },
    {
      "name": "ETL Rejection Rate %",
      "expression": "DIVIDE([ETL Rejected Rows], MAX(Operations[etl_rows_extracted]))",
      "format": "0.00%",
      "description": "Weighted rejected/extracted across successful runs."
    },
    {
      "name": "Data Quality Issues",
      "expression": "SUM('Data Quality'[issue_count])",
      "format": "#,0",
      "description": "Issue observations at ETL/run/source/rule grain; not distinct source records."
    },
    {
      "name": "ETL Successful Runs",
      "expression": "MAX(Operations[etl_successful_runs])",
      "format": "#,0",
      "description": "Audited successful ETL executions."
    }
  ]
}
