		sourceColumn: passed_batches

	column order_status
		dataType: string
		lineageTag: 407eb999-54cf-4e22-9701-7bd7a3f131af
		summarizeBy: none
		sourceColumn: order_status

	partition Production = m
		mode: import
		source =
				let
				    Source = ReportingSource{[Schema="public", Item="vw_production_performance"]}[Data],
				    Filtered = Source,
				    Selected = Table.SelectColumns(Filtered, {"production_order_id", "product_id", "unit_of_measure", "planned_start", "planned_quantity", "actual_quantity", "inspected_batches", "passed_batches", "order_status"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"production_order_id", Int64.Type}, {"product_id", Int64.Type}, {"unit_of_measure", type text}, {"planned_start", type datetime}, {"planned_quantity", type number}, {"actual_quantity", type number}, {"inspected_batches", Int64.Type}, {"passed_batches", Int64.Type}, {"order_status", type text}}),
				    Result = Typed
				in
				    Result
