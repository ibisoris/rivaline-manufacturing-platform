/// One operational production order
table Production
	lineageTag: 5742b7c3-2be8-4711-986d-4b87641a519b

	column production_order_id
		dataType: int64
		isHidden
		lineageTag: d16f3f45-771d-46e7-9074-77ccb616d3b5
		summarizeBy: none
		sourceColumn: production_order_id

	column product_id
		dataType: int64
		isHidden
		lineageTag: 9fe52ade-ef46-4b3f-afc6-c806b070356b
		summarizeBy: none
		sourceColumn: product_id

	column unit_of_measure
		dataType: string
		lineageTag: 28899111-f3fd-4331-bda3-c76b68a707f3
		summarizeBy: none
		sourceColumn: unit_of_measure

	column planned_start
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 0db0dd53-2f11-4311-b55d-d3f4f6d54beb
		summarizeBy: none
		sourceColumn: planned_start

	column planned_quantity
		dataType: double
		formatString: #,0.000000
		lineageTag: 1447f771-0f59-4304-b34b-a9a481b453c4
